{
  "schemaVersion": 1,
  "id": "simpleaimbot",
  "version": "${version}",
  "name": "PolarDLC",
  "description": "PolarDLC client with combat, render, movement, and camera utilities.",
  "authors": [
    "fabric-aimbot"
  ],
  "license": "MIT",
  "icon": "assets/simpleaimbot/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.simpleaimbot.SimpleAimbotMod",
      "com.example.simpleaimbot.freelook.freelook.FreeLookMod"
    ]
  },
  "mixins": [
    "mixins.simpleaimbot.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": ">=1.21.4",
    "java": ">=21"
  }
}
